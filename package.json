{
  "name": "iobroker.jura-wifi-2",
  "version": "0.3.5",
  "description": "Control and monitor a JURA coffee machine over WiFi Connect V2",
  "keywords": ["ioBroker", "jura", "coffee-maker", "wifi-connect"],
  "license": "MIT",
  "author": { "name": "Alexander Groß", "email": "agross@therightstuff.de" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agross/ioBroker.jura-wifi-2.git"
  },
  "main": "build/main.js",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "admin",
    "io-package.json",
    "build/main.js",
    "build/lib/jura.js",
    "lib/catalogs"
  ],
  "scripts": {
    "build": "clean-dir build 1>&2 && tsc --project tsconfig.json",
    "lint": "eslint --max-warnings 0 main.ts lib test scripts",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test \"build/test/**/*.test.js\"",
    "test:package": "node scripts/check-package-versions.cjs && mocha test/package.cjs",
    "test:integration": "mocha test/integration.cjs",
    "test:ci": "node scripts/check-package-versions.cjs && npm test",
    "prepack": "npm run build",
    "release": "release-script"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  }
}
