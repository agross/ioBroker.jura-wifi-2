{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':automergeBranch',
    ':automergeMinor',
    ':disableDigestUpdates',
    ':disableRateLimiting',
    ':enableVulnerabilityAlerts',
    ':maintainLockFilesWeekly',
    ':rebaseStalePrs',
    ':semanticCommitsDisabled',
  ],
  labels: [
    'dependencies',
  ],
}
