{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build",
    "noEmitOnError": true,
    "skipLibCheck": false
  },
  "include": ["main.ts", "lib/**/*.ts", "test/**/*.ts"]
}
